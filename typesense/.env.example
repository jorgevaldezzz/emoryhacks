# Copy to .env.local and fill in. Never commit .env.local.
#   cp .env.example .env.local && chmod 600 .env.local

# Where the Typesense server is. docker compose up -d serves this address.
# For Typesense Cloud use the nodes address from the cluster page, e.g.
# https://xxx-1.a1.typesense.net:443
TYPESENSE_URL=http://localhost:8108

# Admin key: creates collections and imports documents. Server-side only.
# docker compose reads this same value, so the server and the scripts agree.
TYPESENSE_ADMIN_KEY=dev-only-change-me

# Search-only key: safe to hand to the website or any client-side code.
# Generate one against a running server with `npm run search-key`.
TYPESENSE_SEARCH_KEY=

# Overpass endpoint used by `npm run seed:osm`. The public instance is rate
# limited; be gentle with it, or point this at your own.
OVERPASS_URL=https://overpass-api.de/api/interpreter
