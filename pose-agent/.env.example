# Fill these in privately. All three LiveKit values must belong to one project.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# xAI key is used for realtime voice; pose inference runs locally with MediaPipe.
XAI_API_KEY=YOUR_XAI_API_KEY
# Optional Grok model for comparing neutral MediaPipe skeleton overlays.
# XAI_POSE_COACH_MODEL=grok-4.7

# Reference pose for coaching (guide_pose + silent looks) and match_reference_pose.
# Absolute path wins; otherwise the first image in reference-images/ is used.
# POSE_REFERENCE_IMAGE=/absolute/path/to/reference.jpg
# Optional overrides for local MediaPipe installation.
# POSE_PYTHON=/absolute/path/to/python
# POSE_MODEL_PATH=/absolute/path/to/pose_landmarker_full.task

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=pose-agent

# Optional: push each FaceTime snap into the user's IMPhotogenic gallery API.
# Sign up on the website first, then point these at your API host.
# GALLERY_API_URL=https://your-api-host.example.com
# GALLERY_INGEST_SECRET=same-value-as-api-GALLERY_INGEST_SECRET
# GALLERY_USER_EMAIL=you@email.com
