# Bind port (Railway / Render / Fly / Vercel set PORT automatically).
PORT=8787

# Required: used to sign session tokens (min 16 chars).
JWT_SECRET=change-me-to-a-long-random-string

# Optional token lifetime (jsonwebtoken format).
# JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API (your Vercel domain).
# Use * only for local demos.
CORS_ORIGIN=https://your-app.vercel.app,http://127.0.0.1:5500

# Shared secret the Chert pose-agent sends when posting snaps into a gallery.
# Generate with: openssl rand -hex 32
GALLERY_INGEST_SECRET=change-me-to-another-long-random-string

# Soft cap of images per user. Oldest are deleted automatically when exceeded.
GALLERY_MAX_ITEMS=25

# --- Cloud MongoDB (required) ---
# MongoDB Atlas connection string. Stores username, email, bcrypt password hashes,
# and gallery metadata (blob URLs) attached to each user account.
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
# Optional database name (defaults to the URI path / "test"):
# MONGODB_DB=imphotogenic

# --- Vercel Blob (required in production for gallery images) ---
# Create a Blob store in the Vercel dashboard and copy the read-write token.
# Without this token, uploads fall back to local disk (dev/tests only).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_…

# Local upload dir only used when BLOB_READ_WRITE_TOKEN is unset:
# UPLOAD_DIR=./uploads
