# Bind port (Railway / Render / Fly set PORT automatically).
PORT=8787

# Required: used to sign session tokens (min 16 chars).
JWT_SECRET=change-me-to-a-long-random-string

# Optional token lifetime (jsonwebtoken format).
# JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API (your Vercel domain).
# Use * only for local demos.
CORS_ORIGIN=https://your-app.vercel.app,http://127.0.0.1:5500

# Shared secret the Chert pose-agent sends when posting snaps into a gallery.
# Generate with: openssl rand -hex 32
GALLERY_INGEST_SECRET=change-me-to-another-long-random-string

# Soft cap of images per user. Oldest are deleted automatically when exceeded.
GALLERY_MAX_ITEMS=25

# --- Cloud database (recommended for production) ---
# Neon / Supabase / Railway / RDS Postgres URL.
# When set, SQLite is NOT used.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# PG_SSL=0   # only for local Postgres without TLS

# --- Cloud image storage (recommended for production) ---
# S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Supabase Storage S3 API).
# When S3_BUCKET is set, local UPLOAD_DIR is NOT used for new uploads.
# S3_BUCKET=imphotogenic-gallery
# S3_REGION=auto
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=1
# Optional CDN / public bucket base (otherwise /uploads/:filename proxies the object):
# S3_PUBLIC_URL=https://gallery.cdn.example.com
# S3_PREFIX=gallery/

# --- Local-only fallbacks (used when DATABASE_URL / S3_BUCKET are unset) ---
# DATA_DIR=/var/lib/imphotogenic/data
# UPLOAD_DIR=/var/lib/imphotogenic/uploads
# SQLITE_PATH=/var/lib/imphotogenic/data/imphotogenic.sqlite
