# Bind port (Railway / Render / Fly set PORT automatically).
PORT=8787

# Required: used to sign session tokens (min 16 chars).
JWT_SECRET=change-me-to-a-long-random-string

# Optional token lifetime (jsonwebtoken format).
# JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API (your Vercel domain).
# Use * only for local demos.
CORS_ORIGIN=https://your-app.vercel.app,http://127.0.0.1:5500

# Shared secret the Chert pose-agent sends when posting snaps into a gallery.
# Generate with: openssl rand -hex 32
GALLERY_INGEST_SECRET=change-me-to-another-long-random-string

# Background classification and nearby search (server-side only).
XAI_API_KEY=
XAI_BACKGROUND_MODEL=grok-4.7
XAI_BACKGROUND_TIMEOUT_MS=20000
TYPESENSE_URL=http://localhost:8108
# Use a search-only key created with `npm run search-key` in ../typesense.
TYPESENSE_SEARCH_KEY=

# Optional: override where SQLite + image files live (use a persistent volume on the host).
# DATA_DIR=/var/lib/imphotogenic/data
# UPLOAD_DIR=/var/lib/imphotogenic/uploads
# SQLITE_PATH=/var/lib/imphotogenic/data/imphotogenic.sqlite
