# Fill these in privately. All three LiveKit values must belong to one project.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# xAI key for Grok Voice (and later for pose / skeleton matching).
XAI_API_KEY=YOUR_XAI_API_KEY
# Optional vision model. Defaults to grok-4.7.
# XAI_VISION_MODEL=grok-4.7

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=pose-agent

# Text the captured photo back over iMessage.
# FaceTime does not expose the caller phone, so set the verified recipient here.
# PHOTO_RECIPIENT=+15551234567
# Preferred: Messaging API signing secret so the PNG itself is attached.
# CHERT_SIGNING_SECRET=YOUR_CHERT_SIGNING_SECRET
# Fallback text-only Shared send (no image attach):
# CHERT_API_KEY=ftk_YOUR_PROJECT_API_KEY
# CHERT_PROJECT_ID=YOUR_PROJECT_UUID
# CHERT_LINE_ID=YOUR_LINE_UUID
